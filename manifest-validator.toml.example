# There is no authentication here. Who may reach this service is a
# NetworkPolicy question; see README. Callers name checks and never describe
# them, so no request can choose a command to execute.
bind-address = "0.0.0.0:8080"

# How many validations may run at once.
max-concurrent = 4

# Cheap, deterministic and in-process: every document parses and carries
# apiVersion, kind and metadata.name.
[[check]]
name = "structural"
kind = "structural"

# The first rule with teeth. In-process for the same reason.
[[check]]
name = "image-policy"
kind = "image-policy"
allowed-registries = ["public.ecr.aws/"]
require-pinned = true

# KICS runs as a child process of this service, over the tree written to a
# temporary directory. The binary and its query library ship in this image, so
# their paths are not configurable — a config repository that could move them
# could point the scan at a query set inside the tree being scanned.
#
# Only the decisions live here. The rest of the command line is either fixed by
# the image or is the contract with the report reader, and exposing it would
# offer nothing but ways to break the check.
[[check]]
name = "kics"
kind = "kics"
# Platform query sets to run. A generated manifest tree holds neither
# CloudFormation nor Dockerfiles, and each type costs scan time for no findings.
types = ["Kubernetes", "Crossplane"]
# Only critical and high are reported. Excluding every severity is a config
# error: a check that cannot fail is a green verdict that checked nothing.
exclude-severities = ["medium", "low", "info"]
timeout-seconds = 600
